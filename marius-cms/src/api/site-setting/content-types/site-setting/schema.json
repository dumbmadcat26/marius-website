{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting",
    "description": "Global brand, bio metadata, and social links for the portfolio."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Marius Varhaugvik"
    },
    "tagline": {
      "type": "string",
      "default": "composer, sound designer & artistic stage engineer"
    },
    "portrait": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "bioIntro": {
      "type": "text"
    },
    "locationNote": {
      "type": "string"
    },
    "whatIDo": {
      "type": "json"
    },
    "education": {
      "type": "component",
      "repeatable": true,
      "component": "about.education-item"
    },
    "awards": {
      "type": "component",
      "repeatable": true,
      "component": "about.award-item"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "internships": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    }
  }
}
