# Strapi CMS base URL (no trailing slash)
# STRAPI_URL — server/build-time API fetches only (never baked into media src)
STRAPI_URL=http://localhost:1337

# NEXT_PUBLIC_STRAPI_URL — base for image/audio URLs in the browser
# Dev: point at local Strapi so media loads while editing.
# Static / Netlify: leave empty (or omit) so media uses relative /uploads/...
# Production builds ignore localhost here automatically — still use
# `npm run build:static` (not plain `npm run build`) so uploads are copied.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
